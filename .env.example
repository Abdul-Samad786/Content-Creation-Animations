# Copy this file to .env and fill in the values. .env is gitignored.

# ElevenLabs API key (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Voice ids for the series live in src/content/<series>/series.json (cast[].voice.id).
# Legacy degree episode only (scripts/generate_audio.py):
HUMAN_VOICE_ID=your-human-voice-id
AI_AGENT_VOICE_ID=your-ai-voice-id
